# PostgreSQL duy nhất
POSTGRES_DB=domix
POSTGRES_USER=domix
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Tài khoản quản trị đầu tiên
DOMIX_ADMIN_EMAIL=admin@example.com
DOMIX_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Bí mật ký/mã hóa OTP; dùng chuỗi ngẫu nhiên dài và không commit file .env thật
DOMIX_OTP_SECRET=CHANGE_ME_LONG_RANDOM_OTP_SECRET

# Cổng web và CORS
DOMIX_HTTP_PORT=8848
DOMIX_CORS_ORIGIN=*

# SMTP tùy chọn
DOMIX_SMTP_HOST=smtp.gmail.com
DOMIX_SMTP_PORT=465
DOMIX_SMTP_EMAIL=
DOMIX_SMTP_APP_PASSWORD=

# AI tùy chọn
DOMIX_ANTHROPIC_API_KEY=
DOMIX_ANTHROPIC_MODEL=claude-sonnet-4-6
